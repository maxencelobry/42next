    {
      "id": "ex7",
      "title": "Seed Inventory (typed)",
      "file": "ex7/ft_seed_inventory.py",
      "authorized": [
        "print"
      ],
      "only_functions": true,
      "typed": true,
      "tests": [
        {
          "name": "packets unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Tomato seeds: 15 packets available",
            "require": [
              "Tomato",
              "15 packets available"
            ]
          },
          "args": [
            "tomato",
            15,
            "packets"
          ]
        },
        {
          "name": "grams unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Carrot seeds: 8 grams total",
            "require": [
              "Carrot",
              "8 grams total"
            ]
          },
          "args": [
            "carrot",
            8,
            "grams"
          ]
        },
        {
          "name": "area unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Lettuce seeds: covers 12 square meters",
            "require": [
              "Lettuce",
              "covers 12 square meters"
            ]
          },
          "args": [
            "lettuce",
            12,
            "area"
          ]
        },
        {
          "name": "unknown unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Unknown unit type",
            "wording": "exact"
          },
          "args": [
            "basil",
            3,
            "tons"
          ]
        },
        {
          "name": "signature: ft_seed_inventory(seed_type: str, quantity: int, unit: str) -> None",
          "mode": "module",
          "code": [
            "import inspect",
            "sig = inspect.signature(m.ft_seed_inventory)",
            "params = list(sig.parameters.values())",
            "assert [p.name for p in params] == ['seed_type', 'quantity', 'unit'], 'parameters: %r' % [p.name for p in params]",
            "ann = [p.annotation for p in params]",
            "assert ann == [str, int, str] or ann == ['str', 'int', 'str'], 'annotations: %r' % ann",
            "assert sig.return_annotation in (None, 'None'), 'return annotation must be None, got %r' % sig.return_annotation"
          ]
        }
      ]
    }
