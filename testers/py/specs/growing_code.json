{
  "project": "growing_code",
  "title": "Growing Code",
  "note": "Subject v2.0. Each function's output is compared to the subject (prompts included, input() writes them). The outputs are examples: other wording is a warning, the values (numbers, the echoed name, the capital letter) and the messages the subject quotes as fixed (ex1 status, ex5, ex7 units, 'Unknown unit type') must match. Source: only the authorized builtins, no import, nothing but the function(s) in the file (helpers allowed in ex6), real recursion in ex6, type hints + exact signature in ex7, flake8 everywhere, mypy.",
  "exercises": [
    {
      "id": "ex0",
      "title": "Hello Garden",
      "file": "ex0/ft_hello_garden.py",
      "authorized": [
        "print"
      ],
      "only_functions": true,
      "tests": [
        {
          "name": "prints the welcome message",
          "mode": "func_stdio",
          "func": "ft_hello_garden",
          "match": {
            "type": "equals",
            "expected": "Hello, Garden Community!"
          },
          "args": []
        }
      ]
    },
    {
