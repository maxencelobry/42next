      "id": "ex2",
      "title": "Plant Growth Simulator",
      "file": "ex2/ft_plant_growth.py",
      "authorized": [
        "print",
        "range",
        "round"
      ],
      "tests": [
        {
          "name": "runs and summarises weekly growth",
          "mode": "script",
          "match": {
            "exit_code": 0,
            "stdout": {
              "type": "in_order",
              "items": [
                "=== Garden Plant Growth ===",
                "=== Day 1 ===",
                "=== Day 7 ===",
                "Growth this week:"
              ]
            },
            "stderr": {
              "type": "python",
              "code": [
                "assert 'Traceback' not in out, 'crashed: ' + lines[-1]"
              ]
            }
          }
        },
        {
          "name": "Plant has grow() and age()",
          "mode": "module",
          "code": [
            "for meth in ('show', 'grow', 'age'):",
            "    assert callable(getattr(m.Plant, meth, None)), 'Plant.%s() missing' % meth"
          ]
        },
        {
          "name": "grow() and age() change the plant",
          "mode": "module",
          "code": [
            "import inspect",
            "def required(f):",
            "    return [p for p in inspect.signature(f).parameters.values() if p.default is inspect.Parameter.empty and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]",
            "n = len(required(m.Plant))",
            "p = m.Plant(*['Rose', 25.0, 30, 1, 1][:n])",
            "before = dict(vars(p))",
            "_, err = capture(p.grow, *[1] * len(required(p.grow)))",
            "assert err is None, 'grow() raised %r' % err",
            "after_grow = dict(vars(p))",
            "assert after_grow != before, 'grow() changed nothing'",
            "_, err = capture(p.age, *[1] * len(required(p.age)))",
            "assert err is None, 'age() raised %r' % err",
            "assert dict(vars(p)) != after_grow, 'age() changed nothing'"
          ]
        }
      ]
    },
