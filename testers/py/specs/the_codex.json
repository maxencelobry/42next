    {
      "id": "kaboom_0",
      "title": "Part IV: light spell, no circular import",
      "file": "ft_kaboom_0.py",
      "tests": [
        {
          "name": "output matches the subject example",
          "mode": "script",
          "cwd": "root",
          "match": {
            "exit_code": 0,
            "stdout": {
              "type": "lines",
              "items": [
                "=== Kaboom 0 ===",
                {
                  "re": ".+",
                  "subject": "Using grimoire module directly"
                },
                {
                  "re": "Testing record light spell: .*\\bVALID\\b.*",
                  "subject": "Testing record light spell: Spell recorded: Fantasy (Earth, wind and fire - VALID)"
                }
              ]
            }
          }
        },
        {
          "name": "light spellbook / validator behave as the subject says",
          "mode": "module",
          "cwd": "root",
          "load": false,
          "code": [
            "from alchemy.grimoire import light_spellbook, light_validator",
            "allowed = light_spellbook.light_spell_allowed_ingredients()",
            "assert type(allowed) is list and allowed and all(type(x) is str for x in allowed), 'allowed ingredients must be a list of str: %r' % (allowed,)",
            "ok = light_validator.validate_ingredients('Some ' + allowed[0].upper() + ' dust')",
            "assert type(ok) is str and 'VALID' in ok and 'INVALID' not in ok, 'an allowed ingredient (any case) must be VALID: %r' % ok",
            "assert allowed[0].upper() in ok, 'the result should contain the ingredients: %r' % ok",
            "bad = light_validator.validate_ingredients('qqq zzz')",
            "assert 'INVALID' in bad, 'no allowed ingredient must be INVALID: %r' % bad",
            "rec = light_spellbook.light_spell_record('Fantasy', allowed[0])",
            "rej = light_spellbook.light_spell_record('Nope', 'qqq zzz')",
            "assert 'recorded' in rec.lower(), 'a valid spell should be recorded: %r' % rec",
            "assert 'rejected' in rej.lower(), 'an invalid spell should be rejected: %r' % rej",
            "assert rec != rej"
          ]
        },
        {
          "name": "dark_spellbook.py / dark_validator.py exist with renamed functions",
          "mode": "module",
          "cwd": "root",
          "load": false,
          "code": [
            "import ast, os",
            "src = open(os.path.join('alchemy', 'grimoire', 'dark_spellbook.py'), encoding='utf-8').read()",
            "names = {n.name for n in ast.walk(ast.parse(src)) if isinstance(n, ast.FunctionDef)}",
            "for want in ('dark_spell_allowed_ingredients', 'dark_spell_record'):",
            "    assert want in names, 'dark_spellbook.py: %s() missing' % want",
            "assert os.path.isfile(os.path.join('alchemy', 'grimoire', 'dark_validator.py')), 'dark_validator.py missing'"
          ]
        }
      ],
      "require_imports": [
        {
          "kind": "under",
          "module": "alchemy.grimoire"
        }
      ]
    },
    {
      "id": "kaboom_1",
      "title": "Part IV: dark spell, circular import",
      "file": "ft_kaboom_1.py",
      "tests": [
        {
          "name": "importing dark_spellbook explodes with a circular import",
          "mode": "script",
          "cwd": "root",
          "match": {
            "allow_traceback": true,
            "stdout": {
              "type": "lines",
              "tail": false,
              "items": [
                "=== Kaboom 1 ===",
                {
                  "re": ".+",
                  "subject": "Access to alchemy/grimoire/dark_spellbook.py directly"
                },
                {
                  "re": ".+",
                  "subject": "Test import now - THIS WILL RAISE AN UNCAUGHT EXCEPTION"
                }
              ]
            },
            "output": {
              "type": "regex",
              "pattern": "ImportError.*(circular import|partially initialized)"
            }
          }
        }
      ],
      "require_imports": [
        {
          "kind": "under",
          "module": "alchemy.grimoire.dark_spellbook"
        }
      ]
    },
    {
      "id": "package",
      "title": "alchemy package files (source checks)",
      "file": "alchemy/__init__.py",
      "tests": [
        {
          "name": "the tree of the subject is there",
          "mode": "module",
          "cwd": "root",
          "load": false,
          "code": [
            "import os",
            "want = ['alchemy/__init__.py', 'alchemy/elements.py', 'alchemy/potions.py', 'alchemy/transmutation/__init__.py', 'alchemy/transmutation/recipes.py', 'alchemy/grimoire/__init__.py', 'alchemy/grimoire/light_spellbook.py', 'alchemy/grimoire/light_validator.py', 'alchemy/grimoire/dark_spellbook.py', 'alchemy/grimoire/dark_validator.py', 'elements.py']",
            "missing = [f for f in want if not os.path.isfile(f)]",
            "assert not missing, 'missing: ' + ', '.join(missing)"
          ]
        }
      ],
      "also_check": [
        "alchemy/elements.py",
        "alchemy/potions.py",
        "alchemy/transmutation/__init__.py",
        "alchemy/transmutation/recipes.py",
        "alchemy/grimoire/__init__.py",
        "alchemy/grimoire/light_spellbook.py",
        "alchemy/grimoire/light_validator.py",
        "alchemy/grimoire/dark_spellbook.py",
        "alchemy/grimoire/dark_validator.py"
      ]
