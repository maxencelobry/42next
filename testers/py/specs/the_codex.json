    {
      "id": "alembic_4",
      "title": "Part I: import alchemy (create_earth hidden)",
      "file": "ft_alembic_4.py",
      "tests": [
        {
          "name": "creates air, then create_earth is not reachable (AttributeError)",
          "mode": "script",
          "cwd": "root",
          "match": {
            "allow_traceback": true,
            "stdout": {
              "type": "lines",
              "tail": false,
              "items": [
                "=== Alembic 4 ===",
                {
                  "re": ".+",
                  "subject": "Accessing the alchemy module using 'import alchemy'"
                },
                "Testing create_air: Air element created",
                {
                  "re": ".+",
                  "subject": "Now show that not all functions can be reached"
                },
                {
                  "re": ".+",
                  "subject": "This will raise an exception!"
                },
                {
                  "re": ".*",
                  "subject": "Testing the hidden create_earth: "
                }
              ]
            },
            "output": {
              "type": "regex",
              "pattern": "AttributeError.*create_earth"
            }
          }
        },
        {
          "name": "the alchemy package exposes create_air, not create_earth",
          "mode": "module",
          "cwd": "root",
          "load": false,
          "code": [
            "import alchemy",
            "assert getattr(alchemy, 'create_air', None) and alchemy.create_air() == 'Air element created', 'alchemy.create_air() missing'",
            "assert not hasattr(alchemy, 'create_earth'), 'create_earth must not be exposed by alchemy/__init__.py'"
          ]
        }
      ],
      "require_imports": [
        {
          "kind": "import",
          "module": "alchemy"
        }
      ],
      "mypy": "expect_errors"
    },
