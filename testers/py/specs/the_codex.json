{
  "project": "the_codex",
  "title": "The Codex",
  "note": "Subject v2.0. Each script runs from a copy of your project root so alchemy/ resolves. The 'Testing ...' lines and the returned strings are compared to the subject; the description lines may differ (warning). Import styles are read from the source (import ... / from ... import ..., absolute + relative in recipes.py). ft_alembic_4 must hit AttributeError on create_earth, ft_kaboom_1 must hit the circular ImportError. Source: only imports of your own modules, no eval() / exec(), sys.path untouched, type hints, flake8, mypy (ft_alembic_4's mypy error is expected: warning only).",
  "defaults": {
    "typed": true,
    "imports": "local",
    "forbidden": [
      "eval",
      "exec"
    ],
    "no_sys_path": true
  },
