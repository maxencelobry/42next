      "title": "Planting Your First Seed",
      "file": "ex0/ft_garden_intro.py",
      "authorized": [
        "print"
      ],
      "main_guard": true,
      "tests": [
        {
          "name": "runs and prints plant info",
          "mode": "script",
          "match": {
            "exit_code": 0,
            "stdout": {
              "type": "in_order",
              "items": [
                "=== Welcome to My Garden ===",
                "Plant:",
                "Height:",
                "Age:",
                "=== End of Program ==="
              ]
            },
            "stderr": {
              "type": "python",
              "code": [
                "assert 'Traceback' not in out, 'crashed: ' + lines[-1]"
              ]
            }
          }
        },
        {
          "name": "name / height / age stored in simple variables",
          "mode": "module",
          "code": [
            "import ast",
            "src = open(m.__file__, encoding='utf-8').read()",
            "names = {n.id for n in ast.walk(ast.parse(src)) if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Store)}",
            "missing = [w for w in ('name', 'height', 'age') if not any(w in n for n in names)]",
            "assert not missing, 'no variable for: %s' % ', '.join(missing)"
          ]
        }
      ]
    },
