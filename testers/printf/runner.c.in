/* 42next ft_printf runner, generated by run.py. Do not edit. */
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <limits.h>
#include <signal.h>
#include <errno.h>
#include <sys/wait.h>

int		ft_printf(const char *, ...);
typedef int	(*t_pf)(const char *, ...);

#define LONG_LEN @LONG_LEN@
#define CASE_TIMEOUT 3
/* stop the run after this many timeouts (run.py runs one group at a time) */
#define MAX_TIMEOUTS 2

static int		g_nblk;
static int		g_on;
#define MAXBLK 65536
static size_t	g_blksz[MAXBLK];

#ifndef NEXT42_NO_WRAP
/* ---- malloc tracking (only during the ft_printf call, in the child) ---- */
void		*__real_malloc(size_t n);
void		__real_free(void *p);

static void		*g_blk[MAXBLK];

void	*__wrap_malloc(size_t n)
{
	void	*p;

	p = __real_malloc(n);
	if (g_on && p && g_nblk < MAXBLK)
	{
		g_blk[g_nblk] = p;
		g_blksz[g_nblk++] = n;
	}
	return (p);
}

void	__wrap_free(void *p)
{
	int	i;

	if (p && g_on)
	{
		for (i = g_nblk - 1; i >= 0; i--)
		{
			if (g_blk[i] == p)
			{
				g_blk[i] = g_blk[--g_nblk];
				g_blksz[i] = g_blksz[g_nblk];
				break ;
			}
		}
	}
	__real_free(p);
}
#endif
/* NEXT42_NO_WRAP (macOS, no --wrap in ld64): no tracking, g_nblk stays 0 */

static int	g_var = 42;
static void	*g_heap;
static char	g_long[LONG_LEN + 1];
#define S(n) (g_long + LONG_LEN - (n))

static void	wr(int ref, const char *s)
{
	if (ref)
		fflush(stdout);
	if (write(1, s, strlen(s)) < 0)
		return ;
}

static int	run_case(int id, int ref)
{
	t_pf	pf;

	pf = ref ? printf : ft_printf;
	(void)pf;
	(void)wr;
	(void)g_on;
	switch (id)
	{
@CASES@
	}
	return (-12345);
}

static char	*slurp(int fd, size_t *len)
{
	size_t	cap = 4096;
	size_t	n = 0;
	ssize_t	r;
	char	*buf = malloc(cap);

	lseek(fd, 0, SEEK_SET);
	while (buf && (r = read(fd, buf + n, cap - n)) > 0)
	{
		n += (size_t)r;
		if (n == cap)
			buf = realloc(buf, cap *= 2);
	}
	*len = n;
	return (buf);
}

static void	hex(FILE *o, const char *b, size_t n)
{
	size_t	i;

	for (i = 0; i < n; i++)
		fprintf(o, "%02x", (unsigned char)b[i]);
	if (n == 0)
		fputc('-', o);
}

static void	reset(int fd)
{
	if (ftruncate(fd, 0) < 0)
		perror("ftruncate");
	lseek(fd, 0, SEEK_SET);
}

int	main(int ac, char **av)
{
	int		i;
	int		timeouts = 0;

	for (i = 0; i < LONG_LEN; i++)
		g_long[i] = 'a' + i % 26;
	g_heap = malloc(16);
	if (ac < 4)
		return (2);
	if (strcmp(av[1], "direct") == 0)
	{
		for (i = 4; i < ac; i++)
			run_case(atoi(av[i]), 0);
		free(g_heap);
		return (0);
	}
	FILE	*out = fopen(av[2], "w");
	char	rpath[4096];
	char	upath[4096];
	char	epath[4096];
	snprintf(rpath, sizeof rpath, "%s/ref.out", av[3]);
	snprintf(upath, sizeof upath, "%s/usr.out", av[3]);
	snprintf(epath, sizeof epath, "%s/usr.err", av[3]);
	int		efd = open(epath, O_RDWR | O_CREAT | O_TRUNC, 0600);
	int		rfd = open(rpath, O_RDWR | O_CREAT | O_TRUNC, 0600);
	int		ufd = open(upath, O_RDWR | O_CREAT | O_TRUNC, 0600);
	int		saved = dup(1);
	if (!out || rfd < 0 || ufd < 0 || efd < 0 || saved < 0)
		return (perror("runner setup"), 2);
	for (i = 4; i < ac; i++)
	{
		int		id = atoi(av[i]);
		int		rr, ur = 0, st, p[2];
		long	msg[3] = {0, 0, 0};
		size_t	rlen, ulen;
		char	*rb, *ub, status[64];
		pid_t	pid;

		reset(rfd);
		fflush(stdout);
		dup2(rfd, 1);
		rr = run_case(id, 1);
		fflush(stdout);
		dup2(saved, 1);
		rb = slurp(rfd, &rlen);
		reset(ufd);
		reset(efd);
		if (pipe(p) < 0)
			return (perror("pipe"), 2);
		fflush(out);
		pid = fork();
		if (pid == 0)
		{
			close(p[0]);
			dup2(ufd, 1);
			dup2(efd, 2);
			alarm(CASE_TIMEOUT);
			g_nblk = 0;
			g_on = 1;
			ur = run_case(id, 0);
			g_on = 0;
			fflush(stdout);
			msg[0] = ur;
			msg[1] = g_nblk;
			for (int k = 0; k < g_nblk; k++)
				msg[2] += (long)g_blksz[k];
			if (write(p[1], msg, sizeof msg) < 0)
				_exit(3);
			_exit(0);
		}
		close(p[1]);
		waitpid(pid, &st, 0);
		ssize_t got = read(p[0], msg, sizeof msg);
		ur = (int)msg[0];
		close(p[0]);
		if (WIFSIGNALED(st) && WTERMSIG(st) == SIGALRM)
			snprintf(status, sizeof status, "timeout");
		else if (WIFSIGNALED(st))
			snprintf(status, sizeof status, "signal:%d", WTERMSIG(st));
		else if (got != (ssize_t)sizeof msg)
			snprintf(status, sizeof status, "exit:%d", WEXITSTATUS(st));
		else
			snprintf(status, sizeof status, "ok");
		ub = slurp(ufd, &ulen);
		size_t	elen;
		char	*eb = slurp(efd, &elen);
		if (strcmp(status, "ok") == 0 || elen > 8192)
			elen = strcmp(status, "ok") == 0 ? 0 : 8192;
		fprintf(out, "%d\t%s\t%d\t%d\t", id, status, rr, ur);
		hex(out, rb, rlen);
		fputc('\t', out);
		hex(out, ub, ulen);
		fprintf(out, "\t%ld\t%ld\t", msg[1], msg[2]);
		hex(out, eb, elen);
		fputc('\n', out);
		free(rb);
		free(ub);
		free(eb);
		fflush(out);
		if (strcmp(status, "timeout") == 0 && ++timeouts >= MAX_TIMEOUTS)
			break ;
	}
	fclose(out);
	close(rfd);
	close(ufd);
	close(efd);
	close(saved);
	free(g_heap);
	return (0);
}
