          "name": "0 + 0 + 0 -> 0",
          "mode": "func_stdio",
          "func": "ft_harvest_total",
          "stdin": "0\n0\n0\n",
          "match": {
            "type": "equals",
            "expected": "Day 1 harvest: Day 2 harvest: Day 3 harvest: Total harvest: 0",
            "ignore": [
              "Day \\d+ harvest:"
            ]
          }
        }
      ]
    },
    {
      "id": "ex4",
      "title": "Plant Age Check",
      "file": "ex4/ft_plant_age.py",
      "authorized": [
        "input",
        "int",
        "print"
      ],
      "only_functions": true,
      "tests": [
        {
          "name": "75 days -> ready",
          "mode": "func_stdio",
          "func": "ft_plant_age",
          "stdin": "75\n",
          "match": {
            "type": "equals",
            "expected": "Enter plant age in days: Plant is ready to harvest!",
            "forbid": [
              "Plant needs more time to grow."
            ]
          }
        },
        {
          "name": "45 days -> needs more time",
          "mode": "func_stdio",
          "func": "ft_plant_age",
          "stdin": "45\n",
          "match": {
            "type": "equals",
            "expected": "Enter plant age in days: Plant needs more time to grow.",
            "forbid": [
              "Plant is ready to harvest!"
            ]
          }
        },
        {
          "name": "60 days -> needs more time (strictly > 60)",
          "mode": "func_stdio",
          "func": "ft_plant_age",
          "stdin": "60\n",
          "match": {
            "type": "equals",
            "expected": "Enter plant age in days: Plant needs more time to grow.",
            "forbid": [
              "Plant is ready to harvest!"
            ]
          }
        },
        {
          "name": "61 days -> ready",
          "mode": "func_stdio",
          "func": "ft_plant_age",
          "stdin": "61\n",
          "match": {
            "type": "equals",
            "expected": "Enter plant age in days: Plant is ready to harvest!",
            "forbid": [
              "Plant needs more time to grow."
            ]
          }
        },
        {
          "name": "strictly more than 60: 61 / 75 give one message, 45 / 60 the other",
          "mode": "module",
          "code": [
            "def run(days):",
            "    out, err = capture(m.ft_plant_age, stdin='%d\\n' % days)",
            "    assert err is None, '%d days: raised %r' % (days, err)",
            "    return out",
            "assert run(61) == run(75), '61 and 75 days must give the same message (ready)'",
            "assert run(45) == run(60), '45 and 60 days must give the same message (not ready)'",
            "assert run(61) != run(60), '60 days (not ready) and 61 days (ready) must differ'"
          ]
        }
      ]
    },
