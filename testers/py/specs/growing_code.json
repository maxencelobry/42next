      "file": "ex3/ft_harvest_total.py",
      "authorized": [
        "input",
        "int",
        "print"
      ],
      "only_functions": true,
      "tests": [
        {
          "name": "5 + 8 + 3 -> 16",
          "mode": "func_stdio",
          "func": "ft_harvest_total",
          "stdin": "5\n8\n3\n",
          "match": {
